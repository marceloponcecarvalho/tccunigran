const request = require('supertest');

const app = require('../../server');
const con = require('../../src/config/database');
const pool = require('../../src/config/databasePool');

const db = con.promise();
const dbPool = pool.promise();

const cpfTeste = '11122233346';

let idClienteTeste;
let idAgendamentoHoje;
let idAgendamentoEstoque;
let idAgendamentoFuturo;
let idProdutoCloro;
let estoqueOriginal;
let dataHoje;
let dataAmanha;
let bancoConfirmado = false;

const medicoesComCloro = {
    ph: 7.4,
    alcalinidade: 80,
    cloro: 0.5
};

const medicoesIdeais = {
    ph: 7.4,
    alcalinidade: 80,
    cloro: 1
};

// Obter a data local no formato YYYY-MM-DD
function obterDataLocal(data = new Date()) {
    return [
        data.getFullYear(),
        String(data.getMonth() + 1).padStart(2, '0'),
        String(data.getDate()).padStart(2, '0')
    ].join('-');
}

// Preparar os dados utilizados nos testes
beforeAll(async () => {
    const [bancos] = await db.query('SELECT DATABASE() AS nome');

    if (bancos[0].nome !== 'manutencao_piscinas_test') {
        throw new Error(
            'Os testes devem utilizar somente manutencao_piscinas_test.'
        );
    }

    bancoConfirmado = true;

    const hoje = new Date();
    const amanha = new Date(hoje);
    amanha.setDate(amanha.getDate() + 1);

    dataHoje = obterDataLocal(hoje);
    dataAmanha = obterDataLocal(amanha);

    // Remover eventual registro de uma execução anterior
    await db.execute(
        'DELETE FROM Cliente WHERE cpf = ?',
        [cpfTeste]
    );

    const [cliente] = await db.execute(
        `INSERT INTO Cliente (nome, cpf, endereco, telefone, email)
         VALUES (?, ?, ?, ?, ?)`,
        [
            'Cliente Integração Manutenção',
            cpfTeste,
            'Rua Teste, 100',
            '67999999999',
            'manutencao@email.com'
        ]
    );

    idClienteTeste = cliente.insertId;

    // Criar piscina de 48 m³
    await db.execute(
        `INSERT INTO Piscina (profundidade, lado1, lado2, idCliente)
         VALUES (?, ?, ?, ?)`,
        [1.5, 8, 4, idClienteTeste]
    );

    // Criar agendamentos para os cenários de teste
    const [agendamentoHoje] = await db.execute(
        `INSERT INTO Agendamento (data, horario, idCliente)
         VALUES (?, ?, ?)`,
        [dataHoje, '05:00', idClienteTeste]
    );

    idAgendamentoHoje = agendamentoHoje.insertId;

    const [agendamentoEstoque] = await db.execute(
        `INSERT INTO Agendamento (data, horario, idCliente)
         VALUES (?, ?, ?)`,
        [dataHoje, '08:00', idClienteTeste]
    );

    idAgendamentoEstoque = agendamentoEstoque.insertId;

    const [agendamentoFuturo] = await db.execute(
        `INSERT INTO Agendamento (data, horario, idCliente)
         VALUES (?, ?, ?)`,
        [dataAmanha, '11:00', idClienteTeste]
    );

    idAgendamentoFuturo = agendamentoFuturo.insertId;

    // Localizar o produto pelo tipo, sem depender do ID
    const [produtos] = await db.execute(
        'SELECT idProduto, quantidade FROM Produto WHERE tipo = ?',
        ['Cloro']
    );

    if (produtos.length !== 1) {
        throw new Error(
            'O banco de testes deve possuir exatamente um produto Cloro.'
        );
    }

    idProdutoCloro = produtos[0].idProduto;
    estoqueOriginal = produtos[0].quantidade;
});

// Limpar somente os registros criados pelos testes
afterAll(async () => {
    try {
        if (bancoConfirmado) {
            // Restaurar o estoque original
            if (
                idProdutoCloro &&
                estoqueOriginal !== undefined
            ) {
                await db.execute(
                    'UPDATE Produto SET quantidade = ? WHERE idProduto = ?',
                    [estoqueOriginal, idProdutoCloro]
                );
            }

            // As relações do banco removem os registros dependentes
            if (idClienteTeste) {
                await db.execute(
                    'DELETE FROM Cliente WHERE idCliente = ?',
                    [idClienteTeste]
                );
            }
        }
    } finally {
        await dbPool.end();

        await new Promise((resolve, reject) => {
            con.end(erro => {
                if (erro) return reject(erro);
                resolve();
            });
        });
    }
});

// Confirmar o banco utilizado
test('deve utilizar o banco de testes', async () => {
    const [bancos] = await db.query('SELECT DATABASE() AS nome');

    expect(bancos[0].nome).toBe('manutencao_piscinas_test');
});

// Listar agendamentos disponíveis
test('deve listar agendamentos de hoje e não listar os futuros', async () => {
    const resposta = await request(app)
        .get('/manutencoes/agendamentos');

    expect(resposta.status).toBe(200);
    expect(Array.isArray(resposta.body)).toBe(true);

    const agendamentoHoje = resposta.body.find(
        item => Number(item.idAgendamento) === idAgendamentoHoje
    );

    const agendamentoEstoque = resposta.body.find(
        item => Number(item.idAgendamento) === idAgendamentoEstoque
    );

    const agendamentoFuturo = resposta.body.find(
        item => Number(item.idAgendamento) === idAgendamentoFuturo
    );

    expect(agendamentoHoje).toBeDefined();
    expect(agendamentoEstoque).toBeDefined();
    expect(agendamentoFuturo).toBeUndefined();

    expect(agendamentoHoje.nomeCliente).toBe(
        'Cliente Integração Manutenção'
    );

    expect(Number(agendamentoHoje.volume)).toBe(48);
});

// Calcular dosagens usando os dados do agendamento
test('deve calcular o volume e as dosagens da piscina', async () => {
    const resposta = await request(app)
        .post('/manutencoes/calcular')
        .send({
            idAgendamento: idAgendamentoHoje,
            medicoes: medicoesComCloro
        });

    expect(resposta.status).toBe(200);
    expect(resposta.body.idAgendamento).toBe(idAgendamentoHoje);
    expect(Number(resposta.body.idCliente)).toBe(idClienteTeste);
    expect(resposta.body.piscina.volume).toBe(48);

    expect(resposta.body.produtos).toEqual([
        expect.objectContaining({
            tipo: 'Cloro',
            quantidadeUtilizada: 192,
            unidade: 'g'
        })
    ]);
});

// Registrar manutenção e atualizar estoque
test('deve registrar a manutenção e descontar o estoque', async () => {
    // Disponibilizar estoque suficiente para o teste
    await db.execute(
        'UPDATE Produto SET quantidade = ? WHERE idProduto = ?',
        [1000, idProdutoCloro]
    );

    const resposta = await request(app)
        .post('/manutencoes/salvar')
        .send({
            idAgendamento: idAgendamentoHoje,
            medicoes: medicoesComCloro
        });

    expect(resposta.status).toBe(201);
    expect(resposta.body.mensagem).toBe(
        'Manutenção registrada com sucesso.'
    );

    expect(resposta.body.idManutencao).toBeDefined();
    expect(resposta.body.idAgendamento).toBe(idAgendamentoHoje);

    // Confirmar que data e cliente vieram do agendamento
    const [manutencoes] = await db.execute(`
        SELECT
            idManutencao,
            DATE_FORMAT(data, '%Y-%m-%d') AS data,
            idCliente,
            idAgendamento,
            ph,
            alcalinidade,
            cloro
        FROM Manutencao
        WHERE idAgendamento = ?
    `, [idAgendamentoHoje]);

    expect(manutencoes).toHaveLength(1);
    expect(manutencoes[0].data).toBe(dataHoje);
    expect(manutencoes[0].idCliente).toBe(idClienteTeste);
    expect(manutencoes[0].idAgendamento).toBe(idAgendamentoHoje);
    expect(Number(manutencoes[0].ph)).toBe(7.4);
    expect(Number(manutencoes[0].alcalinidade)).toBe(80);
    expect(Number(manutencoes[0].cloro)).toBe(0.5);

    // Confirmar o item de manutenção
    const [itens] = await db.execute(`
        SELECT idProduto, quantidadeUtilizada
        FROM ItemManutencao
        WHERE idManutencao = ?
    `, [resposta.body.idManutencao]);

    expect(itens).toHaveLength(1);
    expect(itens[0].idProduto).toBe(idProdutoCloro);
    expect(itens[0].quantidadeUtilizada).toBe(192);

    // Confirmar a baixa no estoque
    const [produtos] = await db.execute(
        'SELECT quantidade FROM Produto WHERE idProduto = ?',
        [idProdutoCloro]
    );

    expect(produtos[0].quantidade).toBe(808);
});

// Impedir que o mesmo agendamento receba outra manutenção
test('não deve registrar duas manutenções para o mesmo agendamento', async () => {
    const resposta = await request(app)
        .post('/manutencoes/salvar')
        .send({
            idAgendamento: idAgendamentoHoje,
            medicoes: medicoesComCloro
        });

    expect(resposta.status).toBe(400);
    expect(resposta.body.erro).toBe(
        'Agendamento não disponível para realizar manutenção.'
    );

    const [manutencoes] = await db.execute(
        'SELECT idManutencao FROM Manutencao WHERE idAgendamento = ?',
        [idAgendamentoHoje]
    );

    expect(manutencoes).toHaveLength(1);

    const [produtos] = await db.execute(
        'SELECT quantidade FROM Produto WHERE idProduto = ?',
        [idProdutoCloro]
    );

    expect(produtos[0].quantidade).toBe(808);
});

// Impedir gravação quando o estoque for insuficiente
test('deve rejeitar estoque insuficiente sem gravar ou descontar produtos', async () => {
    await db.execute(
        'UPDATE Produto SET quantidade = ? WHERE idProduto = ?',
        [1, idProdutoCloro]
    );

    const resposta = await request(app)
        .post('/manutencoes/salvar')
        .send({
            idAgendamento: idAgendamentoEstoque,
            medicoes: medicoesComCloro
        });

    expect(resposta.status).toBe(409);
    expect(resposta.body.erro).toBe(
        'Estoque insuficiente para um ou mais produtos.'
    );

    expect(resposta.body.detalhes).toEqual([
        expect.objectContaining({
            tipo: 'Cloro',
            unidade: 'g',
            quantidadeNecessaria: 192,
            quantidadeDisponivel: 1,
            quantidadeFaltante: 191
        })
    ]);

    const [manutencoes] = await db.execute(
        'SELECT idManutencao FROM Manutencao WHERE idAgendamento = ?',
        [idAgendamentoEstoque]
    );

    expect(manutencoes).toHaveLength(0);

    const [itens] = await db.execute(`
        SELECT i.idItem
        FROM ItemManutencao i
        INNER JOIN Manutencao m
            ON m.idManutencao = i.idManutencao
        WHERE m.idAgendamento = ?
    `, [idAgendamentoEstoque]);

    expect(itens).toHaveLength(0);

    const [produtos] = await db.execute(
        'SELECT quantidade FROM Produto WHERE idProduto = ?',
        [idProdutoCloro]
    );

    expect(produtos[0].quantidade).toBe(1);
});

// Impedir manutenção em agendamento futuro
test('não deve calcular nem registrar manutenção de agendamento futuro', async () => {
    const lista = await request(app)
        .get('/manutencoes/agendamentos');

    expect(lista.status).toBe(200);

    expect(
        lista.body.some(
            item => Number(item.idAgendamento) === idAgendamentoFuturo
        )
    ).toBe(false);

    const resposta = await request(app)
        .post('/manutencoes/salvar')
        .send({
            idAgendamento: idAgendamentoFuturo,
            medicoes: medicoesIdeais
        });

    expect(resposta.status).toBe(400);
    expect(resposta.body.erro).toBe(
        'Agendamento não disponível para realizar manutenção.'
    );

    const [manutencoes] = await db.execute(
        'SELECT idManutencao FROM Manutencao WHERE idAgendamento = ?',
        [idAgendamentoFuturo]
    );

    expect(manutencoes).toHaveLength(0);
});
