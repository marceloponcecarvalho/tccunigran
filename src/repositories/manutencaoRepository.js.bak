const pool = require('../config/databasePool');

const UNIDADES = {
    'Cloro': 'g',
    'Elevador de alcalinidade': 'g',
    'Elevador de pH': 'ml',
    'Redutor de alcalinidade e pH': 'ml'
};

// Registrar manutenção, produtos utilizados e atualizar estoque
async function salvar(dados) {
    const conexao = await pool.promise().getConnection();
    let transacaoIniciada = false;

    try {
        await conexao.beginTransaction();
        transacaoIniciada = true;

        // Consultar e bloquear o agendamento
        const [agendamentos] = await conexao.execute(`
            SELECT
                a.idAgendamento,
                DATE_FORMAT(a.data, '%Y-%m-%d') AS data,
                a.data <= CURDATE() AS dataValida,
                c.idCliente,
                c.nome AS nomeCliente,
                p.profundidade,
                p.lado1,
                p.lado2
            FROM Agendamento a
            LEFT JOIN Cliente c
                ON c.idCliente = a.idCliente
            LEFT JOIN Piscina p
                ON p.idCliente = c.idCliente
            WHERE a.idAgendamento = ?
            FOR UPDATE
        `, [dados.idAgendamento]);

        if (agendamentos.length === 0) {
            const erro = new Error('Agendamento não encontrado.');
            erro.statusCode = 404;
            throw erro;
        }

        const agendamento = agendamentos[0];

        if (!agendamento.dataValida) {
            const erro = new Error(
                'Não é permitido realizar manutenção em agendamento futuro.'
            );
            erro.statusCode = 400;
            throw erro;
        }

        if (
            !agendamento.idCliente ||
            agendamento.profundidade === null ||
            agendamento.lado1 === null ||
            agendamento.lado2 === null ||
            Number(agendamento.profundidade) <= 0 ||
            Number(agendamento.lado1) <= 0 ||
            Number(agendamento.lado2) <= 0
        ) {
            const erro = new Error(
                'O cliente não possui uma piscina com dimensões válidas.'
            );
            erro.statusCode = 400;
            throw erro;
        }

        // Verificar se o agendamento já possui uma manutenção
        const [manutencoes] = await conexao.execute(`
            SELECT idManutencao
            FROM Manutencao
            WHERE idAgendamento = ?
        `, [dados.idAgendamento]);

        if (manutencoes.length > 0) {
            const erro = new Error(
                'Este agendamento já possui uma manutenção registrada.'
            );
            erro.statusCode = 409;
            throw erro;
        }

        // Consolidar produtos repetidos
        const produtosAgrupados = new Map();

        for (const produto of dados.produtos) {
            const quantidadeAtual =
                produtosAgrupados.get(produto.tipo) || 0;

            produtosAgrupados.set(
                produto.tipo,
                quantidadeAtual + produto.quantidadeUtilizada
            );
        }

        // Ordenar para manter a mesma ordem de bloqueio das linhas
        const produtosSolicitados = [...produtosAgrupados.entries()]
            .sort(([tipoA], [tipoB]) => tipoA.localeCompare(tipoB))
            .map(([tipo, quantidadeUtilizada]) => ({
                tipo,
                quantidadeUtilizada
            }));

        // Verificar todos os produtos e bloquear seus estoques
        const produtosConfirmados = [];
        const faltasEstoque = [];

        for (const produto of produtosSolicitados) {
            const [produtos] = await conexao.execute(`
                SELECT idProduto, tipo, quantidade
                FROM Produto
                WHERE tipo = ?
                FOR UPDATE
            `, [produto.tipo]);

            if (produtos.length === 0) {
                const erro = new Error(
                    `Produto não encontrado: ${produto.tipo}.`
                );
                erro.statusCode = 404;
                throw erro;
            }

            if (produtos.length > 1) {
                const erro = new Error(
                    `Existe mais de um cadastro para o produto ${produto.tipo}.`
                );
                erro.statusCode = 500;
                throw erro;
            }

            const produtoBanco = produtos[0];

            produtosConfirmados.push({
                ...produto,
                idProduto: produtoBanco.idProduto,
                quantidadeDisponivel: produtoBanco.quantidade
            });

            if (produtoBanco.quantidade < produto.quantidadeUtilizada) {
                faltasEstoque.push({
                    tipo: produto.tipo,
                    unidade: UNIDADES[produto.tipo] || '',
                    quantidadeNecessaria: produto.quantidadeUtilizada,
                    quantidadeDisponivel: produtoBanco.quantidade,
                    quantidadeFaltante:
                        produto.quantidadeUtilizada - produtoBanco.quantidade
                });
            }
        }

        // Impedir qualquer gravação se houver falta de estoque
        if (faltasEstoque.length > 0) {
            const erro = new Error(
                'Estoque insuficiente para um ou mais produtos.'
            );
            erro.statusCode = 409;
            erro.detalhes = faltasEstoque;
            throw erro;
        }

        // Registrar a manutenção
        const [resultadoManutencao] = await conexao.execute(`
            INSERT INTO Manutencao (
                data,
                ph,
                alcalinidade,
                cloro,
                idCliente,
                idAgendamento
            )
            VALUES (?, ?, ?, ?, ?, ?)
        `, [
            agendamento.data,
            dados.medicoes.ph,
            dados.medicoes.alcalinidade,
            dados.medicoes.cloro,
            agendamento.idCliente,
            dados.idAgendamento
        ]);

        const idManutencao = resultadoManutencao.insertId;

        // Descontar estoque e registrar os produtos utilizados
        for (const produto of produtosConfirmados) {
            const [resultadoEstoque] = await conexao.execute(`
                UPDATE Produto
                SET quantidade = quantidade - ?
                WHERE idProduto = ?
                  AND quantidade >= ?
            `, [
                produto.quantidadeUtilizada,
                produto.idProduto,
                produto.quantidadeUtilizada
            ]);

            if (resultadoEstoque.affectedRows !== 1) {
                const erro = new Error(
                    `Não foi possível atualizar o estoque de ${produto.tipo}.`
                );
                erro.statusCode = 409;
                throw erro;
            }

            await conexao.execute(`
                INSERT INTO ItemManutencao (
                    idManutencao,
                    idProduto,
                    quantidadeUtilizada
                )
                VALUES (?, ?, ?)
            `, [
                idManutencao,
                produto.idProduto,
                produto.quantidadeUtilizada
            ]);
        }

        await conexao.commit();
        transacaoIniciada = false;

        return {
            idManutencao,
            idAgendamento: dados.idAgendamento,
            data: agendamento.data,
            idCliente: agendamento.idCliente
        };

    } catch (erro) {
        if (transacaoIniciada) {
            try {
                await conexao.rollback();
            } catch (erroRollback) {
                erro.erroRollback = erroRollback;
            }
        }

        throw erro;

    } finally {
        conexao.release();
    }
}


// Listar agendamentos disponíveis para realizar manutenção
async function listarAgendamentosDisponiveis() {
    const db = pool.promise();

    const [agendamentos] = await db.execute(`
        SELECT
            a.idAgendamento,
            DATE_FORMAT(a.data, '%Y-%m-%d') AS data,
            TIME_FORMAT(a.horario, '%H:%i') AS horario,
            c.idCliente,
            c.nome AS nomeCliente,
            ROUND(p.profundidade * p.lado1 * p.lado2, 2) AS volume
        FROM Agendamento a
        INNER JOIN Cliente c
            ON c.idCliente = a.idCliente
        INNER JOIN Piscina p
            ON p.idCliente = c.idCliente
        LEFT JOIN Manutencao m
            ON m.idAgendamento = a.idAgendamento
        WHERE a.data <= CURDATE()
          AND m.idManutencao IS NULL
          AND p.profundidade > 0
          AND p.lado1 > 0
          AND p.lado2 > 0
        ORDER BY a.data, a.horario
    `);

    return agendamentos;
}


// Buscar dados do agendamento, cliente e piscina
async function buscarDadosAgendamento(idAgendamento) {
    const db = pool.promise();

    const [agendamentos] = await db.execute(`
        SELECT
            a.idAgendamento,
            DATE_FORMAT(a.data, '%Y-%m-%d') AS data,
            TIME_FORMAT(a.horario, '%H:%i') AS horario,
            c.idCliente,
            c.nome AS nomeCliente,
            p.profundidade,
            p.lado1,
            p.lado2
        FROM Agendamento a
        INNER JOIN Cliente c
            ON c.idCliente = a.idCliente
        LEFT JOIN Piscina p
            ON p.idCliente = c.idCliente
        WHERE a.idAgendamento = ?
    `, [idAgendamento]);

    return agendamentos[0] || null;
}

module.exports = {
    salvar,
    listarAgendamentosDisponiveis,
    buscarDadosAgendamento
};