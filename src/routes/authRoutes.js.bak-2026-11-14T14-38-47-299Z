const express = require('express');
const rateLimit = require('express-rate-limit');
const authService = require('../services/authService');
const { exigirAutenticacao } = require('../middlewares/authMiddleware');

const router = express.Router();

const limitarLogin = rateLimit({
    windowMs: 15 * 60 * 1000,
    limit: 10,
    standardHeaders: true,
    legacyHeaders: false,
    message: {
        erro: 'Muitas tentativas de acesso. Aguarde 15 minutos antes de tentar novamente.'
    }
});

function responderErro(res, erro) {
    if (erro instanceof authService.AuthError) {
        const status = erro.code === 'CONTA_EXISTENTE' ? 409 : 400;

        return res.status(status).json({
            erro: erro.message,
            codigo: erro.code
        });
    }

    console.error('Erro na autenticação:', erro);

    return res.status(500).json({
        erro: 'Ocorreu um erro interno. Tente novamente.'
    });
}

router.post('/cadastro-inicial', async (req, res) => {
    try {
        const { usuario, senha, confirmarSenha } = req.body;

        if (senha !== confirmarSenha) {
            return res.status(400).json({
                erro: 'A confirmação da senha não corresponde à senha informada.'
            });
        }

        const conta = await authService.criarUsuario(usuario, senha);

        return res.status(201).json({
            mensagem: 'Conta administrativa criada. Faça login para continuar.',
            usuario: conta.usuario
        });
    } catch (erro) {
        return responderErro(res, erro);
    }
});

router.post('/login', limitarLogin, async (req, res) => {
    try {
        const { usuario, senha } = req.body;
        const autenticacao = await authService.autenticar(usuario, senha);

        if (!autenticacao) {
            return res.status(401).json({
                erro: 'Usuário ou senha incorretos.'
            });
        }

        req.session.regenerate((erro) => {
            if (erro) {
                return responderErro(res, erro);
            }

            req.session.autenticado = true;
            req.session.usuario = autenticacao.usuario;
            req.session.versaoCredenciais = autenticacao.versao;

            req.session.save((erroAoSalvar) => {
                if (erroAoSalvar) {
                    return responderErro(res, erroAoSalvar);
                }

                return res.status(200).json({
                    mensagem: 'Login realizado com sucesso.',
                    usuario: autenticacao.usuario
                });
            });
        });
    } catch (erro) {
        return responderErro(res, erro);
    }
});

router.post('/logout', exigirAutenticacao, (req, res) => {
    req.session.destroy((erro) => {
        if (erro) {
            return responderErro(res, erro);
        }

        res.clearCookie('connect.sid');

        return res.status(200).json({
            mensagem: 'Sessão encerrada.'
        });
    });
});

router.get('/conta', exigirAutenticacao, (req, res) => {
    return res.status(200).json({
        usuario: req.session.usuario
    });
});

router.post('/conta', exigirAutenticacao, async (req, res) => {
    try {
        const {
            senhaAtual,
            novoUsuario,
            novaSenha,
            confirmarNovaSenha
        } = req.body;

        if (novaSenha && novaSenha !== confirmarNovaSenha) {
            return res.status(400).json({
                erro: 'A confirmação da nova senha não corresponde à senha informada.'
            });
        }

        const conta = await authService.alterarCredenciais({
            usuarioAtual: req.session.usuario,
            senhaAtual,
            novoUsuario,
            novaSenha
        });

        req.session.destroy((erro) => {
            if (erro) {
                return responderErro(res, erro);
            }

            res.clearCookie('connect.sid');

            return res.status(200).json({
                mensagem: 'Dados da conta alterados. Entre novamente com suas novas credenciais.',
                usuario: conta.usuario
            });
        });
    } catch (erro) {
        return responderErro(res, erro);
    }
});

module.exports = router;
